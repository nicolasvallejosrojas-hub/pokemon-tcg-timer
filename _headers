# Cabeceras de seguridad. Las lee Netlify; GitHub Pages ignora este archivo
# (ahí la política de contenido la pone config.js como <meta>).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000

# Las páginas con sesión no se dejan meter en un marco de otro sitio: sería la
# forma de engañar a alguien para que apriete un botón sin verlo. La vista del
# timer y el perfil de tienda sí se pueden incrustar.
/admin*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/cuenta*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
/muro*
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
